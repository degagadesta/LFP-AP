<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.lfp.ui.PlaceDetailController"
            stylesheets="@../css/style.css"
            styleClass="root">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="navbar">
            <padding>
                <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>
            
            <Button text="← Back" onAction="#handleBack" styleClass="secondary-button"/>
            <Label text="Place Details" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="30" style="-fx-background-color: white; -fx-padding: 40px;">
                <padding>
                    <Insets top="20" right="40" bottom="20" left="40"/>
                </padding>
                
                <!-- Place Name and Category -->
                <VBox spacing="10">
                    <Label fx:id="nameLabel" text="Place Name" 
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="categoryLabel" text="Category" 
                           style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="locationLabel" text="Location" 
                           style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;"/>
                </VBox>
                
                <!-- Description -->
                <VBox spacing="10">
                    <Label text="Description" styleClass="form-title"/>
                    <Label fx:id="descriptionLabel" text="Description text" 
                           wrapText="true" style="-fx-font-size: 14px;"/>
                </VBox>
                
                <!-- Ratings -->
                <VBox spacing="15">
                    <Label text="Ratings" styleClass="form-title"/>
                    
                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="WiFi Quality" styleClass="field-label"/>
                            <Label fx:id="wifiRatingLabel" text="0.0 / 5.0" 
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                        </VBox>
                        
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Customer Service" styleClass="field-label"/>
                            <Label fx:id="serviceRatingLabel" text="0.0 / 5.0" 
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                        </VBox>
                        
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Overall Rating" styleClass="field-label"/>
                            <Label fx:id="overallRatingLabel" text="0.0" 
                                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                        </VBox>
                    </HBox>
                </VBox>
                
                <!-- Actions -->
                <HBox spacing="15">
                    <Button fx:id="favoriteButton" text="♡ Add to Favorites" 
                            onAction="#handleToggleFavorite" styleClass="primary-button"/>
                    <Button fx:id="reportButton" text="⚠ Report Place" 
                            onAction="#handleReport" styleClass="danger-button"/>
                </HBox>
                
                <!-- Status Label -->
                <Label fx:id="statusLabel" styleClass="success-label" 
                       visible="false" wrapText="true"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
