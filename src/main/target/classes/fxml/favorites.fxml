<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.lfp.ui.FavoritesController"
            stylesheets="@../css/style.css"
            styleClass="root">
    
    <!-- Top Navigation Bar -->
    <top>
        <HBox styleClass="navbar" spacing="20" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>
            
            <Label text="WorkSpot" styleClass="logo"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <Button text="Home" onAction="#handleHome" styleClass="nav-button"/>
            <Button text="Contribute" onAction="#handleContribute" styleClass="nav-button"/>
            <Button text="Favorites" styleClass="nav-button-active"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="nav-button"/>
        </HBox>
    </top>
    
    <!-- Main Content -->
    <center>
        <VBox spacing="20" styleClass="content-container">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>
            
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="My Favorites" styleClass="page-title"/>
                <Label fx:id="countLabel" text="(0 places)" styleClass="subtitle"/>
            </HBox>
            
            <!-- Loading Indicator -->
            <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false"/>
            
            <!-- Error Message -->
            <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false"/>
            
            <!-- Empty State -->
            <VBox fx:id="emptyState" alignment="CENTER" spacing="15" visible="false" managed="false">
                <padding>
                    <Insets top="100" bottom="100"/>
                </padding>
                <Label text="No favorites yet" styleClass="empty-title"/>
                <Label text="Start exploring and save your favorite places!" styleClass="empty-subtitle"/>
                <Button text="Browse Places" onAction="#handleHome" styleClass="primary-button"/>
            </VBox>
            
            <!-- Favorites Grid -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="favoritesContainer" spacing="15"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
