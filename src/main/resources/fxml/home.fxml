<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.lfp.ui.HomeController"
            stylesheets="@../css/style.css"
            styleClass="root">
    
    <!-- Top Navigation -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="navbar">
                <padding>
                    <Insets top="15" right="30" bottom="15" left="30"/>
                </padding>
                
                <Label text="💻 LFP" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                
                <TextField fx:id="searchField" promptText="Search places..." 
                          styleClass="search-field" onAction="#handleSearch"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button text="Contribute" onAction="#handleContribute" styleClass="primary-button"/>
                <Button text="Favorites" onAction="#handleFavorites" styleClass="nav-button"/>
                <Label fx:id="usernameLabel" text="User" styleClass="field-label"/>
                <Button text="Logout" onAction="#handleLogout" styleClass="secondary-button"/>
            </HBox>
            
            <!-- Filter Tabs -->
            <HBox spacing="0" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets top="10" right="30" bottom="10" left="30"/>
                </padding>
                
                <Button fx:id="allButton" text="All Places" onAction="#handleFilterAll" 
                        styleClass="filter-tab"/>
                <Button fx:id="newButton" text="New" onAction="#handleFilterNew" 
                        styleClass="filter-tab"/>
                <Button fx:id="popularButton" text="Popular" onAction="#handleFilterPopular" 
                        styleClass="filter-tab"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Main Content -->
    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                <VBox spacing="20">
                    <padding>
                        <Insets top="30" right="30" bottom="30" left="30"/>
                    </padding>
                    
                    <Label fx:id="errorLabel" styleClass="error-label" 
                           visible="false" managed="false" wrapText="true"/>
                    
                    <GridPane fx:id="placesGrid" hgap="20" vgap="20"/>
                </VBox>
            </ScrollPane>
            
            <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false"/>
        </StackPane>
    </center>
</BorderPane>
