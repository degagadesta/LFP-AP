<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.lfp.ui.LoginController" 
            styleClass="root" 
            prefWidth="600" prefHeight="700">
    
    <!-- Header -->
    <top>
        <VBox alignment="CENTER" spacing="10" styleClass="header" style="-fx-background-color: #2c3e50;">
            <Text text="Laptop Friendly Places" styleClass="title" style="-fx-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Text text="Find the perfect spot to work with your laptop" style="-fx-fill: #ecf0f1; -fx-font-size: 10px;"/>
        </VBox>
    </top>
    
    <!-- Center - Tabbed Login and Register Forms -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 20;">
            
            <!-- Tab Buttons -->
            <HBox alignment="CENTER" spacing="0" style="-fx-background-color: white; -fx-background-radius: 10 10 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" prefWidth="450">
                <Button fx:id="loginTab" text="Login" onAction="#showLoginForm" 
                       style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15 60; -fx-background-radius: 10 0 0 0; -fx-cursor: hand; -fx-border-width: 0;" 
                       prefWidth="225"/>
                <Button fx:id="registerTab" text="Register" onAction="#showRegisterForm" 
                       style="-fx-background-color: #ecf0f1; -fx-text-fill: #7f8c8d; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15 60; -fx-background-radius: 0 10 0 0; -fx-cursor: hand; -fx-border-width: 0;" 
                       prefWidth="225"/>
            </HBox>
            
            <!-- Forms Container -->
            <StackPane prefWidth="450" prefHeight="750">
            
                <!-- Login Form -->
                <VBox fx:id="loginForm" spacing="15" alignment="TOP_CENTER" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 0 0 10 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" visible="true">
                    
                    <VBox spacing="8">
                        <Label text="Email or Username" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                        <TextField fx:id="loginUsername" promptText="Enter your email or username" 
                                  style="-fx-padding: 10; -fx-font-size: 13px; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;" prefWidth="380"/>
                    </VBox>
                    
                    <VBox spacing="8">
                        <Label text="Password" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                        <PasswordField fx:id="loginPassword" promptText="Enter your password" 
                                      style="-fx-padding: 10; -fx-font-size: 13px; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;" prefWidth="380"/>
                    </VBox>
                    
                    <Label fx:id="loginError" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" visible="false" managed="false"/>
                    
                    <ProgressIndicator fx:id="loginLoading" visible="false" managed="false" prefWidth="30" prefHeight="30"/>
                    
                    <Button fx:id="loginButton" text="Login" onAction="#handleLogin" 
                           style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 40; -fx-background-radius: 5; -fx-cursor: hand;" 
                           prefWidth="250"/>
                    
                    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
                        <Text text="Test Credentials:" style="-fx-font-size: 11px; -fx-fill: #7f8c8d; -fx-font-style: italic;"/>
                        <Text text="Admin: admin@laptopfriendly.com / admin123" style="-fx-font-size: 10px; -fx-fill: #95a5a6;"/>
                        <Text text="User: test@example.com / test123" style="-fx-font-size: 10px; -fx-fill: #95a5a6;"/>
                    </VBox>
                    
                    <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0 0 0;">
                        <Text text="Don't have an account?" style="-fx-font-size: 12px; -fx-fill: #7f8c8d;"/>
                        <Hyperlink text="Register here" onAction="#showRegisterForm" style="-fx-font-size: 12px; -fx-text-fill: #3498db;"/>
                    </HBox>
                </VBox>
                
                <!-- Register Form -->
                <VBox fx:id="registerForm" spacing="15" alignment="TOP_CENTER" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 0 0 10 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" visible="false">
                    
                    <VBox spacing="8">
                        <Label text="Username" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                        <TextField fx:id="registerUsername" promptText="Choose a username" 
                                  style="-fx-padding: 10; -fx-font-size: 13px; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;" prefWidth="380"/>
                    </VBox>
                    
                    <VBox spacing="8">
                        <Label text="Email" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                        <TextField fx:id="registerEmail" promptText="Enter your email" 
                                  style="-fx-padding: 10; -fx-font-size: 13px; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;" prefWidth="380"/>
                    </VBox>
                    
                    <VBox spacing="8">
                        <Label text="Password" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                        <PasswordField fx:id="registerPassword" promptText="Choose a password (min 6 characters)" 
                                      style="-fx-padding: 10; -fx-font-size: 13px; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;" prefWidth="380"/>
                    </VBox>
                    
                    <VBox spacing="8">
                        <Label text="Confirm Password" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                        <PasswordField fx:id="registerConfirmPassword" promptText="Confirm your password" 
                                      style="-fx-padding: 10; -fx-font-size: 13px; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;" prefWidth="380"/>
                    </VBox>
                    
                    <Label fx:id="registerError" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" visible="false" managed="false"/>
                    <Label fx:id="registerSuccess" text="" style="-fx-text-fill: #27ae60; -fx-font-size: 12px;" visible="false" managed="false"/>
                    
                    <ProgressIndicator fx:id="registerLoading" visible="false" managed="false" prefWidth="30" prefHeight="30"/>
                    
                    <Button fx:id="registerButton" text="Register" onAction="#handleRegister" 
                           style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 40; -fx-background-radius: 5; -fx-cursor: hand;" 
                           prefWidth="250"/>
                    
                    <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0 0 0;">
                        <Text text="Already have an account?" style="-fx-font-size: 12px; -fx-fill: #7f8c8d;"/>
                        <Hyperlink text="Login here" onAction="#showLoginForm" style="-fx-font-size: 12px; -fx-text-fill: #3498db;"/>
                    </HBox>
                </VBox>
                
            </StackPane>
            
        </VBox>
    </center>
    
    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #ecf0f1; -fx-padding: 15;">
            <Text text="© 2026 Laptop Friendly Places | Advanced Programming Project" style="-fx-fill: #7f8c8d; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>
    
</BorderPane>
