<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.lfp.ui.ContributeController"
            stylesheets="@../css/style.css"
            styleClass="root">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="navbar">
            <padding>
                <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>
            
            <Button text="← Back" onAction="#handleBack" styleClass="secondary-button"/>
            <Label text="Contribute a Place" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-background-color: white; -fx-max-width: 600px;">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>
                
                <Label text="Add a New Place" styleClass="form-title"/>
                
                <!-- Place Name -->
                <VBox spacing="5">
                    <Label text="Place Name *" styleClass="field-label"/>
                    <TextField fx:id="nameField" promptText="Enter place name" styleClass="text-field"/>
                    <Label fx:id="nameError" styleClass="error-label" visible="false" managed="false"/>
                </VBox>
                
                <!-- Category -->
                <VBox spacing="5">
                    <Label text="Category *" styleClass="field-label"/>
                    <ComboBox fx:id="categoryCombo" promptText="Select category" 
                             styleClass="text-field" maxWidth="Infinity"/>
                    <Label fx:id="categoryError" styleClass="error-label" visible="false" managed="false"/>
                </VBox>
                
                <!-- Location -->
                <VBox spacing="5">
                    <Label text="Location/Address *" styleClass="field-label"/>
                    <TextField fx:id="locationField" promptText="Enter address" styleClass="text-field"/>
                    <Label fx:id="locationError" styleClass="error-label" visible="false" managed="false"/>
                </VBox>
                
                <!-- WiFi Rating -->
                <VBox spacing="5">
                    <Label text="WiFi Quality (1-5) *" styleClass="field-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Slider fx:id="wifiSlider" min="1" max="5" value="3" 
                               showTickLabels="true" showTickMarks="true" 
                               majorTickUnit="1" minorTickCount="0" 
                               snapToTicks="true" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="wifiValueLabel" text="3.0" 
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-min-width: 40px;"/>
                    </HBox>
                </VBox>
                
                <!-- Service Rating -->
                <VBox spacing="5">
                    <Label text="Customer Service (1-5) *" styleClass="field-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Slider fx:id="serviceSlider" min="1" max="5" value="3" 
                               showTickLabels="true" showTickMarks="true" 
                               majorTickUnit="1" minorTickCount="0" 
                               snapToTicks="true" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="serviceValueLabel" text="3.0" 
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-min-width: 40px;"/>
                    </HBox>
                </VBox>
                
                <!-- Description -->
                <VBox spacing="5">
                    <Label text="Description" styleClass="field-label"/>
                    <TextArea fx:id="descriptionArea" promptText="Describe this place..." 
                             wrapText="true" prefRowCount="4" styleClass="text-field"/>
                </VBox>
                
                <!-- Status Messages -->
                <Label fx:id="errorLabel" styleClass="error-label" 
                       visible="false" managed="false" wrapText="true"/>
                <Label fx:id="successLabel" styleClass="success-label" 
                       visible="false" managed="false" wrapText="true"/>
                
                <!-- Submit Button -->
                <HBox spacing="15">
                    <Button fx:id="submitButton" text="Submit Place" 
                           onAction="#handleSubmit" styleClass="primary-button" 
                           prefWidth="200"/>
                    <ProgressIndicator fx:id="loadingIndicator" 
                                     visible="false" managed="false" 
                                     maxWidth="30" maxHeight="30"/>
                </HBox>
                
                <Label text="* Required fields" 
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
